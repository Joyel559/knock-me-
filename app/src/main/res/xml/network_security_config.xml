<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, everywhere, in debug and release alike. Knock Me only ever talks to the
     keyless public OSRM/Nominatim/Photon servers and osmdroid tile servers, all over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
