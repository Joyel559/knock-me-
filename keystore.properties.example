# Copy this file to keystore.properties (same folder, project root) and fill in real values.
# keystore.properties is git-ignored — never commit your real keystore path or passwords.
#
# To create a keystore:
#   keytool -genkey -v -keystore knockme-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias knockme
#
# storeFile is relative to the project root.
storeFile=
storePassword=
keyAlias=
keyPassword=
